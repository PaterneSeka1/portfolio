generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Profile {
  id                String   @id @default(cuid())
  name              String
  title             String
  promise           String
  location          String
  available         Boolean  @default(true)
  availabilityLabel String
  email             String
  phone             String?
  whatsapp          String?
  github            String?
  linkedin          String?
  cvUrl             String?
  heroPhoto         String?
  updatedAt         DateTime @updatedAt
}

model BrandSettings {
  id                 String   @id @default(cuid())
  logoUrl             String?
  faviconUrl          String?
  colorNavy           String   @default("#0D1B2A")
  colorInstitutional  String   @default("#133A7C")
  colorAccent         String   @default("#2563EB")
  colorGrayLight      String   @default("#F1F3F6")
  fontHeading         String   @default("Sora")
  fontBody            String   @default("Inter")
  ogImage             String?
  updatedAt           DateTime @updatedAt
}

enum ProjectCategory {
  business
  saas
  website
}

enum ProjectVisibility {
  public
  private
}

model Project {
  id           String            @id @default(cuid())
  slug         String            @unique
  title        String
  category     ProjectCategory
  visibility   ProjectVisibility
  summary      String
  technologies String[]
  publicUrl    String?
  githubUrl    String?
  ctaLabel     String
  ctaHref      String
  featured     Boolean           @default(false)
  order        Int               @default(0)
  published    Boolean           @default(true)
  seoTitle       String?
  seoDescription String?
  caseStudy    Json?
  images       ProjectImage[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
}

model ProjectImage {
  id        String  @id @default(cuid())
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String
  url       String
  alt       String?
  order     Int     @default(0)
}

model Expertise {
  id           String   @id @default(cuid())
  title        String
  description  String
  icon         String
  technologies String[]
  order        Int      @default(0)
  visible      Boolean  @default(true)
}

model Skill {
  id       String  @id @default(cuid())
  category String
  name     String
  icon     String?
  order    Int     @default(0)
  visible  Boolean @default(true)
}

model Experience {
  id        String   @id @default(cuid())
  company   String
  role      String
  period    String?
  missions  String[]
  order     Int      @default(0)
  published Boolean  @default(true)
}

enum MessageStatus {
  new
  read
  archived
}

model ContactMessage {
  id          String        @id @default(cuid())
  name        String
  email       String
  company     String?
  phone       String?
  projectType String
  budget      String?
  timeline    String
  message     String
  status      MessageStatus @default(new)
  createdAt   DateTime      @default(now())
}

model Media {
  id        String   @id @default(cuid())
  url       String
  alt       String?
  type      String
  size      Int?
  createdAt DateTime @default(now())
}

model SiteSettings {
  id              String   @id @default(cuid())
  seoTitle        String?
  seoDescription  String?
  ogImage         String?
  contactEmail    String?
  contactPhone    String?
  smtpHost        String?
  smtpUser        String?
  analyticsId     String?
  domain          String?
  maintenanceMode Boolean  @default(false)
  updatedAt       DateTime @updatedAt
}
